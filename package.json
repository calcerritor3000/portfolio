{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web && node scripts/inject-preloader.js && node scripts/inject-analytics.js",
    "deploy": "npm run build && npx eas-cli@latest deploy --prod",
    "sync:3d": "npm --prefix \"../Portafolio 3D\" run build && node -e \"const f=require('fs');f.rmSync('public/3d',{recursive:true,force:true});f.cpSync('../Portafolio 3D/dist','public/3d',{recursive:true})\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.26",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
